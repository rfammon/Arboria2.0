.env
.env.local
.env.development.local
.env.test.local
.env.production.local
supabase-key*
*supabase-client*.js
service-account.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# IDEs / Editors
.idea/
.vscode/
!.vscode/settings.json
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Brain / Agents
.gemini/
.agent/workflows_disabled/
.opencode_backup/
compressed_screenshot.png

# Arboria Specific
Arboria - deprecated/
